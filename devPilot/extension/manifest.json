{
  "manifest_version": 3,
  "name": "DevPilot GU Course File Helper",
  "version": "1.1.0",
  "description": "Find and download course PDFs and PowerPoints visible on a GU LMS page.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://gulms.galgotiasuniversity.org/*"
  ],
  "action": {
    "default_title": "Find GU course files",
    "default_popup": "popup.html"
  }
}
